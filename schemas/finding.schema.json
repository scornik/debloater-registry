{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://debloater.hakeemify.com/schemas/finding.schema.json",
  "title": "Finding",
  "description": "A conclusion drawn from facts. Never a change. Severity (how much it matters), risk (how dangerous the change would be) and confidence (how sure we are) are three independent dimensions and must not be collapsed into one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "severity",
    "risk",
    "confidence",
    "title",
    "summary",
    "why",
    "evidence",
    "decision",
    "undo"
  ],
  "properties": {
    "id": {
      "description": "Dot-namespaced finding id, e.g. wp.heartbeat.aggressive.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "category": { "$ref": "#/definitions/category" },
    "severity": { "$ref": "#/definitions/severity" },
    "risk": { "$ref": "#/definitions/risk" },
    "confidence": {
      "description": "How sure we are the finding and its recommendation are correct.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "why": {
      "description": "Why this matters, in the user's terms.",
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "description": "At least one entry. Every entry names the fact key it came from; evidence without provenance is not allowed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "fact"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "value": {},
          "fact": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9][a-z0-9_-]*)+$"
          }
        }
      }
    },
    "impact": {
      "description": "Estimated effect in a countable unit. Never time.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "estimate", "unit", "measurable"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "estimate": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "measurable": {
          "description": "Whether the Meter can prove this delta after applying.",
          "type": "boolean"
        }
      }
    },
    "decision": { "$ref": "#/definitions/decision" },
    "decision_reason": {
      "description": "Required when the decision is dont_touch.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "recommendation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tweak_id"],
      "properties": {
        "tweak_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "params": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "undo": {
      "description": "Whether the recommended change can be undone.",
      "type": "boolean"
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies_detected": {
      "description": "How many detected dependents rely on what would be changed.",
      "type": "integer",
      "minimum": 0
    }
  },
  "definitions": {
    "category": {
      "type": "string",
      "enum": ["wordpress", "configuration", "database", "plugins", "maintenance", "admin", "assets"]
    },
    "severity": {
      "description": "How much this matters.",
      "type": "string",
      "enum": ["info", "low", "medium", "high"]
    },
    "risk": {
      "description": "How dangerous the recommended change is. Independent of severity.",
      "type": "string",
      "enum": ["safe", "low", "medium", "high"]
    },
    "decision": {
      "type": "string",
      "enum": ["recommend", "dont_touch", "info"]
    }
  }
}
